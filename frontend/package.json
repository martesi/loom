{
  "name": "loom-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "check": "biome check",
    "format": "biome check --write",
    "test": "bun run test:unit && bun run test:harness",
    "test:unit": "bun test src",
    "test:harness": "node --test e2e/build-cache.test.ts e2e/build-lock.test.ts e2e/file-lock.test.ts e2e/process-tree.test.ts e2e/fixture-isolation.test.ts",
    "i18n:extract": "lingui extract",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test:e2e": "bun run typecheck:e2e && playwright test",
    "benchmark:1k": "bun run typecheck:e2e && playwright test -c playwright.benchmark.config.ts canvas-benchmark",
    "benchmark:drag": "bun run typecheck:e2e && playwright test -c playwright.benchmark.config.ts drag-fps-benchmark",
    "benchmark:pan": "bun run typecheck:e2e && playwright test -c playwright.benchmark.config.ts canvas-pan-benchmark"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@wailsio/runtime": "3.1.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-dag": "^1.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "yet-another-react-lightbox": "^3.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@happy-dom/global-registrator": "^21.0.4",
    "@lingui/babel-plugin-lingui-macro": "^6.12.0",
    "@lingui/cli": "^6.12.0",
    "@lingui/vite-plugin": "^6.12.0",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
