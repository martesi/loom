<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="loom"
        Arguments=""
        InstallLocation="C:\Program Files\Loom\Loom">
    </Installer>
    <PackageInformation
        PackageName="Loom"
        PackageDisplayName="Loom"
        PublisherName="CN=Loom"
        PublisherDisplayName="Loom"
        Version="0.1.0.0"
        PackageDescription="Local-first image derivation manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.loom.app"
                Description="Local-first image derivation manager"
                DisplayName="Loom"
                ExecutableName="loom"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Loom</DisplayName>
            <PublisherDisplayName>Loom</PublisherDisplayName>
            <Description>Local-first image derivation manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="loom.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
